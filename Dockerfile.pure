# Pure-Go build of autonomous-monitor. No CGO, no librdkafka, no musl-dev.
# Useful for fresh-laptop development, scratch-base images, and CI runners
# that don't have a C toolchain pre-installed. The output binary behaves
# identically to the default confluent-kafka-go build.
#
#   docker build -f Dockerfile.pure -t autonomous-monitor:dev-pure .
#
# This file is the build path documented in CONTRIBUTING.md. The default
# Dockerfile in this directory remains the production build target and
# is what release-please publishes to ghcr.io.

FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -tags 'musl kafka_pure' -trimpath -ldflags "-s -w" -o /autonomous-monitor .

FROM alpine:3.23
RUN apk add --no-cache ca-certificates \
	&& addgroup -g 65532 -S autonomous-monitor \
	&& adduser -u 65532 -S -D -H -G autonomous-monitor autonomous-monitor
COPY --from=builder /autonomous-monitor /autonomous-monitor

USER 65532:65532
CMD ["/autonomous-monitor"]
